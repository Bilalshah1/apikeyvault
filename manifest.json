{
  "manifest_version": 3,
  "name": "APIKeyVault",
  "description": "Offline-first, encrypted API key manager that runs entirely in your browser.",
  "version": "0.1.0",

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "APIKeyVault"
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.x.ai/*",
    "https://api.anthropic.com/*",
    "https://api-inference.huggingface.co/*"
  ]
}
